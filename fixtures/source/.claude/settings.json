{
  "permissions": {
    "allow": ["Bash(npm test *)", "Bash(npm run lint *)"]
  },
  "extraKnownMarketplaces": {
    "acme-team": { "source": { "source": "directory", "path": "../team" } }
  },
  "enabledPlugins": {
    "code-review@acme-team": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.sh" }]
      }
    ]
  }
}
